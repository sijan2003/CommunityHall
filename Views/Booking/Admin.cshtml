@model IEnumerable<EnhancedHallBooking.Models.Booking>

<section class="py-4">
    <h2 class="text-center">Admin Dashboard</h2>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Facility</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.Id</td>
                        <td>@booking.Name</td>
                        <td>@booking.Email</td>
                        <td>@booking.Facility</td>
                        <td>@booking.BookingDate.ToString("yyyy-MM-dd")</td>
                        <td>@booking.StartTime - @booking.EndTime</td>
                        <td>
                            <span class="badge @(booking.Status == "Approved" ? "bg-success" : booking.Status == "Pending" ? "bg-warning" : "bg-danger")">
                                @booking.Status
                            </span>
                        </td>
                        <td>
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@booking.Id" />
                                <select name="status" onchange="this.form.submit()" class="form-select form-select-sm">
                                    <option value="Pending" selected="@(booking.Status == "Pending")">Pending</option>
                                    <option value="Approved" selected="@(booking.Status == "Approved")">Approved</option>
                                    <option value="Rejected" selected="@(booking.Status == "Rejected")">Rejected</option>
                                </select>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>