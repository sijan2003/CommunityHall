<section class="py-4">
    <h2 class="text-center">Our Facilities</h2>
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <img src="~/images/main hall.jpg" class="card-img-top" alt="Main Hall" loading="lazy">
                <div class="card-body">
                    <h3 class="card-title">Main Hall</h3>
                    <p class="card-text">Capacity: 200 people. Perfect for weddings and large events.</p>
                    <a asp-controller="Booking" asp-action="Create" class="btn btn-outline-primary">Book Now</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <img src="~/images/meeting hall.jpg" class="card-img-top" alt="Meeting Room" loading="lazy">
                <div class="card-body">
                    <h3 class="card-title">Meeting Room</h3>
                    <p class="card-text">Capacity: 50 people. Ideal for workshops and seminars.</p>
                    <a asp-controller="Booking" asp-action="Create" class="btn btn-outline-primary">Book Now</a>
                </div>
            </div>
        </div>
    </div>
</section>
