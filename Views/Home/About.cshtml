@* Views/Home/About.cshtml *@
@{
    ViewData["Title"] = "About Us";
}

<section class="about-section py-5">
    <div class="container">
        <h1 class="text-center mb-4">About Us</h1>
        <div class="row">
            <div class="col-md-8 mx-auto">
                <p class="lead text-center">
                    The Community Hall Booking Portal is dedicated to making it easy for you to reserve community halls and facilities for your events, meetings, and gatherings.
                </p>
                <p>
                    Our mission is to streamline the booking process with a user-friendly platform, transparent availability, and reliable support. Whether you're planning a wedding, community event, or corporate meeting, we’re here to help you find the perfect venue.
                </p>
            </div>
        </div>
        <div class="row mt-5">
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <i class="fas fa-users fa-3x mb-3 text-primary"></i>
                        <h5 class="card-title">Community Focused</h5>
                        <p class="card-text">Serving communities by providing accessible booking solutions.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <i class="fas fa-calendar-check fa-3x mb-3 text-primary"></i>
                        <h5 class="card-title">Easy Booking</h5>
                        <p class="card-text">Book facilities in just a few clicks with real-time availability.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <i class="fas fa-headset fa-3x mb-3 text-primary"></i>
                        <h5 class="card-title">24/7 Support</h5>
                        <p class="card-text">Our team is here to assist you anytime.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>